# =============================================================================
# Memora — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Provider selection
#   LLM_PROVIDER       openai | anthropic   — chat, classification, planning
#   VISION_PROVIDER    openai | anthropic   — image reading (defaults to LLM_PROVIDER)
#   EMBEDDING_PROVIDER openai | local       — 'local' runs bge-small in-process: no API calls
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
VISION_PROVIDER=
EMBEDDING_PROVIDER=local

# Anthropic (used when LLM_PROVIDER or VISION_PROVIDER = anthropic)
# Leave ANTHROPIC_API_KEY empty to let the SDK use ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-opus-5
ANTHROPIC_REASONING_MODEL=claude-opus-5
ANTHROPIC_VISION_MODEL=claude-opus-5
# Server-side refusal fallbacks (recommended)
ANTHROPIC_FALLBACKS=true
# Thinking depth per call type: low | medium | high
ANTHROPIC_EFFORT_CHAT=low
ANTHROPIC_EFFORT_PLANNING=medium

# Local embeddings (EMBEDDING_PROVIDER=local). Model is downloaded once (~30 MB) into the cache dir.
LOCAL_EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
LOCAL_EMBEDDING_DIMENSIONS=384
TRANSFORMERS_CACHE_DIR=./.cache/transformers

# Call-reduction toggles (both default true)
#   Routine confirmations (done/skip/delete/add) are answered from templates, not a model call.
LLM_TEMPLATE_ROUTINE_REPLIES=true
#   Trivial commands ("done", "show plan") skip the classifier.
LLM_FAST_CLASSIFY=true
# Send response_format=json_object on JSON prompts (OpenAI-compatible hosts that support it)
LLM_JSON_MODE=false

# LLM Configuration — Chat/Text (any OpenAI-compatible API: SambaNova, Groq, Ollama, OpenAI...)
LLM_BASE_URL=https://api.sambanova.ai/v1
LLM_API_KEY=your_sambanova_api_key_here
LLM_CHAT_MODEL=MiniMax-M2.7
LLM_REASONING_MODEL=MiniMax-M2.7
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# LLM Configuration — Vision (leave empty to use LLM_BASE_URL / LLM_API_KEY)
VISION_BASE_URL=https://api.tokenfactory.nebius.com/v1/
VISION_API_KEY=your_api_key_here
LLM_VISION_MODEL=meta-llama/Llama-3.2-90B-Vision-Instruct

# LLM Configuration — Embedding (leave empty to use LLM_BASE_URL / LLM_API_KEY)
EMBEDDING_BASE_URL=https://api.tokenfactory.nebius.com/v1/
EMBEDDING_API_KEY=your_api_key_here
LLM_EMBEDDING_MODEL=BAAI/bge-en-icl
EMBEDDING_DIMENSIONS=4096

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Production only: set this to your public HTTPS URL + /telegram/webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Infrastructure
# Redis — local Docker (port 6380) or Upstash for prod (rediss://...)
REDIS_URL=redis://localhost:6380
# MongoDB Atlas — mongodb+srv://user:pass@cluster.mongodb.net/assistant
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/assistant
# Qdrant Cloud — https://xxxx.us-east4-0.gcp.cloud.qdrant.io
QDRANT_URL=https://xxxx.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# Default User Settings (overridable per-user in MongoDB)
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_WORKING_HOURS_START=08:00
DEFAULT_WORKING_HOURS_END=23:00
DEFAULT_BUFFER_MINUTES=10
DEFAULT_REMINDER_LEAD_MINUTES=10
DEFAULT_SLACK_PERCENTAGE=20
DEFAULT_MAX_REPLAN_FREQUENCY_MINUTES=5
DEFAULT_DAILY_PLAN_TIME=07:30
DEFAULT_ANALYTICS_TIME=23:30
DEFAULT_SNOOZE_MINUTES=15
DEFAULT_MEMORY_CONFIDENCE_THRESHOLD=0.7
DEFAULT_MEMORY_MIN_DATA_POINTS=3

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
